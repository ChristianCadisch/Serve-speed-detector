      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A strongly deviating upper-body alignment can interfere with coordinated stroke execution. Biomechanical principles emphasize that all involved body segments must be well coordinated to achieve a stable and effective stroke"
        }
      }
    }
  },

