"backhand_q13_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Was ist ein zentraler Vorteil einer frühen Einheitdrehung (Unit Turn) bei der Rückhand?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What is a key benefit of executing the unit turn early on the backhand?" } }
  }
},
"backhand_q13_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie verzögert die Wahrnehmung des Gegners" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It delays the opponent’s read" } }
  }
},
"backhand_q13_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Hauptvorteil liegt in der Bewegungseffizienz" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The benefit is movement efficiency" } }
