  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Ideal für agressiven Topspin mit der einhändigen Rückhand"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Ideal for aggressive topspin on the one-handed backhand"
      }
    }
  }
},


"backhand_q1_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Semi-Western Vorhandgriff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Semi-Western Forehand Grip"
      }
    }
  }
},
"backhand_q1_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Dieser Griff wird für Vorhandschläge verwendet"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This grip is used for forehands"
      }
    }
  }
},



"backhand_q2_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Welche erste Bewegung sollte ein Rechtshänder machen, sobald er erkennt, dass der Ball auf die Rückhand kommt?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "What is the primary action a right-handed player should take immediately after recognizing a ball coming to the backhand side?"
      }
    }
  }
},
"backhand_q2_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Den Arm zum Ziel ausstrecken"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Extend the arm toward the target"
      }
    }
  }
},


"backhand_q2_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Das passiert erst nahe am Treffpunkt"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Arm extension happens later, near contact"
      }
    }
  }
},
"backhand_q2_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Den Oberkörper seitlich drehen und die rechte Schulter zum Netz zeigen"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Turn the upper body sideways to the net, pointing the right shoulder toward the net"
      }
    }
  }
},
"backhand_q2_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Die Seitdrehung sollte sofort erfolgen"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "You should turn sideways immediately after reading the shot"
      }
    }
  }
},

"backhand_q2_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Das Körpergewicht auf den vorderen Fuß verlagern"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Shift the body weight onto the front foot"
      }
    }
  }
},


"backhand_q2_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Die Gewichtsverlagerung passiert später im Schlag"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Weight transfer happens later in the swing"
      }
    }
    }
  },





  "backhand_q3_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Wo sollte der Ball bei einer ein- oder beidhändigen Rückhand getroffen werden?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Where should a player aim to make contact with the ball when executing a one-handed or two-handed backhand?"
      }
    }
  }
},
"backhand_q3_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Hinter der Hüfte, nah am Körper"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Behind the hip, close to the body"
      }
    }
  }
},
"backhand_q3_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zu naher Treffpunkt reduziert Kontrolle"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Contacting too close reduces control"
      }
    }
  }
},
"backhand_q3_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Vor dem Körper"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Out in front of the body"
      }
    }
  }
},
"backhand_q3_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Der korrekte Treffpunkt liegt vor dem Körper"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Correct contact point is in front of the body"
      }
    }
  }
},
"backhand_q3_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Direkt neben dem Körper, beim vorderen Fuß"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Directly beside the body, near the front foot"
      }
    }
  }
},
"backhand_q3_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Führt zu schlechtem Energietransfer"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This causes poor energy transfer"
      }
    }
  }
},

"backhand_q4_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Was ist das Ziel eines Tief-zu-Hoch-Schwünge bei der Rückhand?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "What is the goal of utilizing a low-to-high swing path on a backhand groundstroke?"
      }
    }
  }
},
"backhand_q4_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Topspin erzeugen und den Ball ins Feld heben"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To generate topspin and lift the ball into the court"
      }
    }
  }
},
"backhand_q4_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Der Schläger streicht von unten nach oben über den Ball"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This swing brushes up to create topspin"
      }
    }
  }
},
"backhand_q4_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Einen flachen, harten Winner schlagen"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To achieve a flat, powerful winner"
      }
    }
  }
},



"backhand_q4_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Ein flacher Schlag nutzt eine andere Schwungbahn"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A flat shot uses a different path"
      }
    }
  }
},
"backhand_q4_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Den Ausschwung verkürzen und Verletzungen vermeiden"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To shorten the follow-through and reduce injury"
      }
    }
  }
},
"backhand_q4_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Ein voller Ausschwung hilft Verletzungen zu vermeiden"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A full follow-through helps prevent injury"
      }
    }
  }
},

"backhand_q5_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Was ist ein gemeinsames Merkmal einer guten Power Position bei ein- und beidhändiger Rückhand?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "What is a common trait of a good power position for both one-handed and two-handed backhands?"
      }
    }
  }
},
"backhand_q5_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Der Schlägerkopf ist tiefer als der Griff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "The racket head is lower than the grip level"
      }
    }
  }
},
"backhand_q5_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Der Schlägerkopf sollte höher sein"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "The racket head should be higher"
      }
    }
  }
},
"backhand_q5_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Die Schultern sind entspannt und zeigen zum Seitenzaun"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "The shoulders are relaxed and facing the side fence"
      }
    }
  }
},
"backhand_q5_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Die Schultern sollten voll eingedreht sein"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "The shoulders should be fully coiled"
      }
    }
  }
},
"backhand_q5_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Der Schlägerkopf ist höher als der Griff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "The racket head is higher than the grip level"
      }
    }
  }
},
"backhand_q5_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Ein höherer Schlägerkopf erzeugt bessere Hebelwirkung"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A higher racket head creates better leverage"
      }
    }
  }
},

"backhand_q6_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Welcher Griff wird für die obere Hand (linke Hand) bei einer beidhändigen Rückhand eines Rechtshänders empfohlen?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "For a right-handed player using a two-handed backhand, which grip is recommended for the top hand (the left hand)?"
      }
    }
  }
},
"backhand_q6_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Eastern Vorhandgriff oder Semi-Western Griff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "An Eastern forehand grip or Semi-western grip"
      }
    }
  }
},
"backhand_q6_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Die obere Hand schlägt wie eine Vorhand"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "The top hand drives the stroke like a forehand"
      }
    }
  }
},
"backhand_q6_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Continental Griff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A Continental grip"
      }
    }
  }
},
"backhand_q6_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Wird meist von der unteren Hand verwendet"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This is usually used by the bottom hand"
      }
    }
  }
},
"backhand_q6_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Hammergriff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A Hammer grip"
      }
    }
  }
},
"backhand_q6_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Dieser Griff wird für Aufschläge und Volleys genutzt"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This grip is used for serves and volleys"
      }
    }
  }
},

"backhand_q7_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Wohin bewegt sich der Schläger bei einer reinen Oberkörper-Drehung von der 12-Uhr-Position?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "During the unit turn on the backhand, if the player coils their upper body without moving their arms, where does the racket move from the initial 12 o'clock position?"
      }
    }
  }
},
"backhand_q7_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zur 6-Uhr-Position (zum Boden)"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To a 6 o'clock position (facing the ground)"
      }
    }
  }
},
"backhand_q7_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Das gehört nicht zur Rückhand-Drehung"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This is not part of the backhand coil"
      }
    }
  }
},
"backhand_q7_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zur 3-Uhr-Position (zur rechten Platzseite)"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To a 3 o'clock position (facing the right side of the court)"
      }
    }
  }
},
"backhand_q7_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Das ist typisch für die Vorhand-Drehung"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This is typical for forehand coils"
      }
    }
  }
},
"backhand_q7_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zur 9-Uhr-Position (zur linken Platzseite)"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To a 9 o'clock position (facing the left side of the court)"
      }
    }
  }
},
"backhand_q7_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Eine reine Oberkörper-Drehung bringt den Schläger auf 9 Uhr"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A pure upper-body coil rotates it to 9 o'clock"
      }
    }
  }
},

"backhand_q8_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : { "state" : "translated", "value" : "Warum wird der Eastern Rückhandgriff mit der unteren Hand bei der beidhändigen Rückhand nicht empfohlen?" }
    },
    "en" : {
      "stringUnit" : { "state" : "translated", "value" : "Why is using an Eastern backhand grip on the bottom hand discouraged for a two-handed backhand?" }
    }
  }
},
"backhand_q8_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er verursacht zu viel Belastung im Handgelenk" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It causes excessive wrist strain" } }
  }
},
"backhand_q8_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Hauptproblem ist die Flugbahn, nicht die Belastung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The main issue is shot flatness, not strain" } }
  }
},
"backhand_q8_a2" : {
