    "backhand_q1_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Welcher Griff wird für eine aggressive Topspin-einhändige Rückhand empfohlen, wie sie z.B. von Roger Federer und Stan Wawrinka gespielt wird?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "What grip is recommended for hitting an aggressive topspin one-handed backhand, as used by players like Roger Federer and Stan Wawrinka?"
      }
    }
  }
},


"backhand_q1_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Continental Griff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Continental Grip"
      }
    }
  }
},
"backhand_q1_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Wird hauptsächlich für Slice, Volleys und Aufschläge verwendet"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Mainly used for slices, volleys, and serves"
      }
    }
  }
},


"backhand_q1_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Eastern Rückhandgriff"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Eastern Backhand Grip"
      }
    }
  }
},
