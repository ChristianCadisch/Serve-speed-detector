    },
    "tactics_q9_a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schlagen lieber vorbei als zu lobben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They prefer to pass you rather than lob you"
          }
        }
