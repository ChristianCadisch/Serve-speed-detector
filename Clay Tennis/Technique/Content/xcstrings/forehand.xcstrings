  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Gestreckt und voll durchgedrückt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Straight and fully extended" } }
  }
},
"forehand_q17_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein gestreckter Arm erhöht die Belastung im Schultergelenk" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "A straight arm places great stress on the shoulder joint" } }
  }
},
"forehand_q17_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Gebeugt und in den Körper gezogen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Bent, pulling the racket into the body/chest" } }
