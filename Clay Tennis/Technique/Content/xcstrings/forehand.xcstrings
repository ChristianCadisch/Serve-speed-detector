  }
},
"forehand_q17_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Finish sollte um den Körper herum erfolgen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The finish should wrap around the body" } }
  }
},

"forehand_q18_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Warum entwickeln junge Spieler oft einen extremen Vorhandgriff?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Why do young players often develop the extreme forehand grip?" } }
  }
},
"forehand_q18_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Um flache, schnelle Bälle besser schlagen zu können" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "To maximize ability to hit flat, fast balls" } }
  }
},
"forehand_q18_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Griff ist dafür ungeeignet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The grip is unsuitable for flat, fast balls" } }
  }
},
"forehand_q18_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie müssen oft Bälle über Schulterhöhe spielen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "They must frequently hit balls above shoulder height due to early transition to normal balls and height" } }
