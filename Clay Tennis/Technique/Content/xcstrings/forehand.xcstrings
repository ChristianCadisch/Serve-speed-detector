  }
},

"forehand_q17_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche Ellbogenposition reduziert die Schulterbelastung beim Über-die-Brust-Finish?" } },
