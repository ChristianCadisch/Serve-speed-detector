},
"forehand_q18_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der extreme Griff hilft bei hohen Treffpunkten" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The extreme grip helps them return balls frequently above shoulder height" } }
  }
},
"forehand_q18_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie imitieren ausschließlich Profispieler" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "They are mimicking professional players who use this grip exclusively" } }
  }
},
"forehand_q18_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er ist im Gegenteil langfristig leistungshemmend" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This grip limits variability and is performance-limiting" } }
  }
},

