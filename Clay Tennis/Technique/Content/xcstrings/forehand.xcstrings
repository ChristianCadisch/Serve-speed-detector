{
  "sourceLanguage" : "en",
  "strings" : {
    



"forehand_q1_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welcher Griff wird für eine vielseitige Vorhand empfohlen, der sowohl aggressiven Topspin als auch flache Schläge erlaubt?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Which grip is recommended for a versatile forehand, allowing for aggressive topspin and flat shots?" } }
  }
},
"forehand_q1_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Continental Griff" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Continental Grip" } }
  }
},
"forehand_q1_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird hauptsächlich für Aufschläge und Slice verwendet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Used for serves and slices" } }
  }
},
"forehand_q1_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Semi-Western Vorhandgriff" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Semi-Western Forehand Grip (Mittlerer VH Griff)" } }
  }
},
"forehand_q1_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Empfohlen, da er Topspin ermöglicht und gleichzeitig flache Schläge zulässt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Recommended as it allows topspin while also enabling the player to flatten out the shot" } }
  }
},
"forehand_q1_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Eastern Rückhandgriff" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Eastern Backhand Grip" } }
  }
},
"forehand_q1_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird für die einhändige Rückhand verwendet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Used for the one-handed backhand" } }
  }
},

"forehand_q2_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wo sollte sich der Schlägerkopf in der Grundstellung relativ zum Griff befinden?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "In the ready position, where should the racket head be relative to the grip?" } }
  }
},
"forehand_q2_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Unterhalb der Griffhöhe" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Lower than the grip level" } }
  }
},
"forehand_q2_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine schlechte Position, die Zeit kostet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "A poor position that costs time" } }
  }
},
"forehand_q2_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Parallel zum Boden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Parallel to the ground" } }
  }
},
"forehand_q2_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schlägerkopf sollte höher als der Griff sein" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The head should be higher than the grip" } }
  }
},
"forehand_q2_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Höher als die Griffhöhe" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Higher than the grip level" } }
  }
},
"forehand_q2_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine hohe Schlägerposition schafft Hebelwirkung für den Schlag" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Having the racket head higher than the grip creates leverage for the stroke" } }
  }
},

"forehand_q3_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie nennt man die erste seitliche Rotation des Oberkörpers vom Netz weg?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What is the name for the initial rotation of the upper body sideways to the net?" } }
  }
},
"forehand_q3_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Split Step" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The Split Step" } }
  }
},
"forehand_q3_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein kleiner Sprung zur Initiierung und Vorbereitung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "A hop for initiation and preparation" } }
  }
},
"forehand_q3_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Power Position" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The Power Position" } }
  }
},
"forehand_q3_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die aufgedrehte Position nach der Vorbereitung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The coiled position reached after preparation" } }
  }
},
"forehand_q3_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Unit Turn" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The Unit Turn" } }
  }
},
"forehand_q3_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Oberkörperrotation, die die Vorbereitung einleitet und Energie speichert" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The rotation of the upper body that kicks off preparation and stores energy" } }
  }
},

"forehand_q4_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wo befindet sich bei der ATP-Vorhand am häufigsten der Endpunkt des Schlagarms (Ellbogen)?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What is the most common finish location for the hitting elbow on the ATP forehand?" } }
  }
},
"forehand_q4_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Nahe der Hüfte" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Near the hip" } }
  }
},
"forehand_q4_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das ist nicht das typische Durchschwingen auf der Tour" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This is not the common follow-through finish" } }
  }
},
"forehand_q4_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Über die Brust" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Across the chest" } }
  }
},
"forehand_q4_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Ellbogen wird in den Körper gezogen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The most commonly used forehand finish on the ATP tour pulls the elbow into the body" } }
  }
},
"forehand_q4_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Hinter dem Rücken" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Behind the back" } }
  }
},
"forehand_q4_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Finish wird meist vermieden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This finish is generally avoided" } }
  }
},

"forehand_q5_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wo sollte sich der Treffpunkt idealerweise befinden?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Where should the contact point ideally be located?" } }
  }
},
"forehand_q5_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Direkt neben dem Körper" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Directly alongside the body" } }
  }
},
"forehand_q5_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Treffpunkt muss vor dem Körper liegen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Contact must be made out in front" } }
  }
},
"forehand_q5_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Hinter dem Körper" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Behind the body" } }
  }
},
"forehand_q5_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein zu später Treffpunkt zerstört den Schlag" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "A late contact destroys the shot" } }
  }
},
"forehand_q5_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Seitlich vor dem Körper, zwischen Hüft- und Schulterhöhe" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Laterally in front, between hip and shoulder height" } }
  }
},
"forehand_q5_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Treffpunkt sollte seitlich vor dem Körper liegen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The contact point should be laterally in front, between the hip and shoulder" } }
  }
},

"forehand_q6_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "In welcher Muskelgruppe speichert der Unit Turn hauptsächlich Energie?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The Unit Turn stores energy in which muscle group?" } }
  }
},
"forehand_q6_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Quadrizeps und hintere Oberschenkelmuskulatur" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Quadriceps and hamstrings" } }
  }
},
"forehand_q6_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Beine liefern hauptsächlich die Bodenreaktionskraft" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Legs are used for ground force" } }
  }
},
"forehand_q6_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Rumpfmuskulatur, besonders die schrägen Bauchmuskeln" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Trunk muscles, especially the obliques" } }
  }
},
"forehand_q6_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Rotation speichert Energie im Rumpf" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Rotating the upper body stores energy in the trunk muscles (obliques)" } }
  }
},
"forehand_q6_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Unterarm- und Handgelenksbeuger" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Forearm and wrist flexors" } }
  }
},
"forehand_q6_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese sind für die Endbeschleunigung wichtig" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "These are critical for final acceleration" } }
  }
},

"forehand_q7_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Was ist die Hauptaktion bei einer schnell geschlagenen Vorhand?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What is the primary action in a quickly hit forehand?" } }
  }
},
"forehand_q7_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Fixieren des Handgelenks" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Fixing the wrist position" } }
  }
},
"forehand_q7_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das passiert erst direkt beim Treffpunkt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This occurs right at contact" } }
  }
},
"forehand_q7_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Maximale Beschleunigung des Schlägerkopfs von unten nach vorne oben" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Accelerating the racket head maximally from below to front above" } }
  }
},
"forehand_q7_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Hauptaktion ist die maximale Beschleunigung des Schlägerkopfs" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The primary action is maximally accelerating the racket head from below to front above" } }
  }
},
"forehand_q7_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Verkürzen der Ausholbewegung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Minimizing the overall swing path" } }
  }
},
"forehand_q7_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das ist nur Teil der Vorbereitung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This is a preparatory action" } }
  }
},

"forehand_q8_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welchen Hauptvorteil bringt der sogenannte »Racket Lag« bei der Vorhand?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What key advantage does \"Racket Lag\" provide in the forehand?" } }
  }
},
"forehand_q8_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er verkürzt die Schwungbahn" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It shortens the swing path" } }
  }
},
"forehand_q8_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er verkürzt die Schwungbahn nicht zwingend" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It doesn't necessarily shorten the path" } }
  }
},
"forehand_q8_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er verhindert eine Handgelenksstreckung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It prevents wrist extension" } }
  }
},
"forehand_q8_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Lag beinhaltet meist eine Streckung im Handgelenk" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Lag usually involves wrist extension" } }
  }
},
"forehand_q8_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er schafft Hebelwirkung für Power und Kontrolle" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It provides leverage over the ball for power and control" } }
  }
},
"forehand_q8_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der nachlaufende Schlägerkopf erzeugt zusätzliche Hebelwirkung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Racket lag, where the head trails the grip, provides leverage for extra power and control" } }
  }
},

"forehand_q9_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wo sollte sich die nicht schlagende Hand in der Power Position befinden?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Where should the non-hitting hand be in the Power Position?" } }
  }
},
"forehand_q9_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Hinter dem Rücken eingeklappt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Tucked behind the back" } }
  }
},
"forehand_q9_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie sollte vorne am Körper bleiben" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It should be held across the body" } }
  }
},
"forehand_q9_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Am Griff nahe der Schlagseite" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Holding the grip near the hitting hip" } }
  }
},
"forehand_q9_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie sollte quer vor dem Körper bleiben" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It should be across the front of the body" } }
  }
},
"forehand_q9_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Quer vor dem Körper, zum Ausbalancieren und Ballverfolgen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Across the body, balancing and tracking the ball" } }
  }
},
"forehand_q9_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die freie Hand hilft bei Balance und Orientierung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The non-hitting hand helps balance the upper body and track the ball" } }
  }
},

"forehand_q10_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Warum ist der extreme Vorhandgriff (Westerngriff) langfristig limitierend?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Why is the Extreme Forehand Grip (Westerngriff) limiting for long-term performance?" } }
  }
},
"forehand_q10_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er erschwert das Erzeugen von Topspin" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It makes generating topspin difficult" } }
  }
},
"forehand_q10_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er ist eher für starken Topspin geeignet" } },
