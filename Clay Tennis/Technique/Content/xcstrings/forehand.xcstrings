"forehand_q15_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche Stopptaktik zwingt einen »Huge Forehand« Spieler zu einem defensiven Rückschlag?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What drop shot tactic forces a \"Huge Forehand\" opponent into a conservative return?" } }
  }
},
"forehand_q15_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Stoppbälle auf die Vorhandseite" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Drop shots to their forehand side" } }
  }
},
"forehand_q15_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ziel ist es, die schwächere Rückhand anzugreifen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The goal is to play to their weaker backhand" } }
  }
},
"forehand_q15_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Stoppbälle auf die Rückhandseite" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Drop shots to their backhand side" } }
  }
},
"forehand_q15_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie zwingen den Gegner, überzulaufen und defensiv zu spielen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This forces them to run up and over, making a forehand difficult and forcing a conservative shot" } }
  }
},
"forehand_q15_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wiederholt in die Mitte" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Repeated drop shots to the center" } }
  }
},
"forehand_q15_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das nutzt seine Schwäche nicht gezielt aus" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This does not exploit their weakness" } }
  }
},

"forehand_q16_text" : {
  "extractionState" : "manual",
  "localizations" : {
