"legwork_q16_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche Beschreibung trifft die korrekte Ausführung des Kreuzschritts am besten?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Which set of instructions accurately describes the correct execution of the crossover step (Kreuzschritt)?" } }
  }
},
"legwork_q16_a1" : {
  "extractionState" : "manual",
  "localizations" : {
