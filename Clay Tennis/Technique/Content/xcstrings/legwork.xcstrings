    "en" : { "stringUnit" : { "state" : "translated", "value" : "Starting with a large jump, crossing the arms, and avoiding the split-step afterward" } }
  }
},
"legwork_q16_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
