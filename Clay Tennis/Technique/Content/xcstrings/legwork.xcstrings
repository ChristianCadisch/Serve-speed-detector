{
  "sourceLanguage" : "en",
  "strings" : {




"legwork_q1_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Was ist die Hauptfunktion des Split-Step in der Beinarbeit im Tennis?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What is the primary function of the Split-Step in tennis footwork?" } }
  }
},
"legwork_q1_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine geschlossene Stellung für mehr Stabilität sicherstellen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "To ensure a closed stance for stability" } }
  }
},
"legwork_q1_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Split-Step dient der unmittelbaren Schlagvorbereitung und Richtungsänderung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The split-step is for immediate strike preparation and quick direction change" } }
  }
},
"legwork_q1_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktivierung der Beinmuskulatur für einen schnellen Start in jede Richtung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "To activate leg musculature for a quick start in any direction" } }
  }
},
"legwork_q1_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der dynamische Split-Step aktiviert die Beinmuskulatur für einen schnellen Start" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The dynamic split-step activates the leg muscles for a fast start" } }
  }
},
"legwork_q1_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Einleitung der Körperrotation für mehr Schlagkraft" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "To initiate the body coil for groundstroke power" } }
  }
},
"legwork_q1_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Körperrotation wird durch den Unit Turn eingeleitet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The unit turn initiates the coil" } }
  }
},
"legwork_q2_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche der folgenden Optionen ist KEINE der drei Hauptstellungen zur Maximierung der Bodenreaktionskraft beim Aufschlag?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Which of the following is NOT listed as one of the three main stances used to maximize ground force on the tennis serve?" } }
  }
},
"legwork_q2_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Platform-Stance" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Platform Stance" } }
  }
},
"legwork_q2_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Platform-Stance gehört zu den drei Hauptstellungen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The platform stance is one of the three main stances" } }
  }
},
"legwork_q2_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Continental-Stance" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Continental Stance" } }
  }
},
"legwork_q2_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die drei Hauptstellungen sind Platform, Pinpoint und Hybrid" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The three main stances are the Platform Stance, the Pinpoint Stance and the Hybrid Stance" } }
  }
},
"legwork_q2_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Pinpoint-Stance" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Pinpoint Stance" } }
  }
},
"legwork_q2_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Pinpoint-Stance ist eine der drei Hauptstellungen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The pinpoint stance is one of the three main stances" } }
  }
},

"legwork_q3_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie sollte ein Spieler beim Volley seinen Körperschwerpunkt im Vergleich zur Grundstellung anpassen?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "When preparing for a volley, how should a player adjust their center of gravity compared to their baseline ready position?" } }
  }
},
"legwork_q3_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schwerpunkt sollte höher liegen, um die Reichweite zu erhöhen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The COG should be slightly higher to increase reach" } }
  }
},
"legwork_q3_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein hoher Schwerpunkt macht den Spieler weniger explosiv" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "A high COG would make the player less explosive" } }
  }
},
"legwork_q3_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schwerpunkt bleibt gleich wie an der Grundlinie" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The COG should be the same as the baseline ready position" } }
  }
},
"legwork_q3_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Am Netz muss der Schwerpunkt angepasst werden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The COG should be adjusted for the net" } }
  }
},
"legwork_q3_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schwerpunkt sollte tiefer liegen für explosionsartigeren Abdruck" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The COG should be lower to allow for a more explosive push-off" } }
  }
},
"legwork_q3_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Volley sollte der Schwerpunkt tiefer sein für besseren Abdruck" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "For volleys, the COG should be lower to allow a more explosive push-off" } }
  }
},

"legwork_q4_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welches grundlegende Element ist entscheidend für die optimale Positionierung zum Treffpunkt eines Schlages?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What fundamental element is identified as the key to achieving optimal positioning for the contact point of a tennis stroke?" } }
  }
},
"legwork_q4_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der verwendete Griff" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The grip used" } }
  }
},
"legwork_q4_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Griff beeinflusst die Technik, nicht die Positionierung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Grip influences technique, but not positioning" } }
  }
},
"legwork_q4_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Tennisspezifische Beinarbeit" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Tennis-specific footwork" } }
  }
},
"legwork_q4_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Beinarbeit ist entscheidend für die optimale Distanz und Position zum Ball" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Footwork is the key to optimal positioning and distance to the contact point" } }
  }
},
"legwork_q4_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der verwendete Schläger" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The type of racket used" } }
  }
},
"legwork_q4_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schläger beeinflusst Kraft und Gefühl, aber nicht die Positionierung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This affects power and feel, not positioning" } }
  }
},

"legwork_q5_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Was ist ein Hauptvorteil einer offenen Schlagstellung im Tennis?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What is a main advantage of using an open striking stance in tennis?" } }
  }
},
"legwork_q5_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie garantiert eine besonders stabile Position für präzise Angriffsbälle" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It guarantees a stable position for precise attack balls" } }
  }
},
"legwork_q5_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies ist eher ein Vorteil der geschlossenen Stellung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This is a benefit of the closed stance" } }
  }
},
"legwork_q5_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie erlaubt ein unmittelbares Verlagern des Körpergewichts nach vorne" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It allows the player to immediately bring the body weight forward into the court" } }
  }
},
"legwork_q5_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies ist typisch für die geschlossene Stellung oder den Schlagschritt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This is typically associated with the closed stance or strike step" } }
  }
},
"legwork_q5_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sie ermöglicht es, unter Zeitdruck sofort schlagbereit zu sein und schnell zu erholen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It allows the player to be ready for the stroke immediately under time pressure and recover quickly" } }
  }
},
"legwork_q5_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein Hauptvorteil ist die schnelle Schlagbereitschaft und Rückkehr in die Grundposition" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "A main advantage of the open stance is immediate readiness and quick recovery" } }
  }
},

"legwork_q6_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Warum wird empfohlen, beim Rückhand-Unit-Turn mit Laufschritten statt nur mit Sidesteps zum Ball zu kommen?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Why is it recommended to use normal running steps instead of only side steps during the unit turn of the backhand?" } }
  }
},
"legwork_q6_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Laufschritte erlauben es, länger in einer geschlossenen Stellung zu bleiben" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Running steps allow the player to maintain a closed stance longer" } }
  }
},
"legwork_q6_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Laufschritte verbessern Zeit- und Energieeffizienz" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Running steps maximize time and energy efficiency" } }
  }
},
"legwork_q6_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sidesteps sind zu langsam und ermüden den Spieler unnötig" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Side steps take too much time and tire the player out" } }
  }
},
"legwork_q6_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein häufiger Fehler sind Sidesteps zum Ball, die zu viel Zeit und Energie kosten" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Side steps take too much time and energy; turning early allows running steps" } }
  }
},
"legwork_q6_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sidesteps werden nur beim Angriff ans Netz verwendet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Side steps are only used when attacking the net" } }
  }
},
"legwork_q6_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sidesteps werden auch bei der Rückkehr in die Mitte genutzt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Side steps are also used when recovering back to the center" } }
  }
},

"legwork_q7_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Was definiert den Schlagschritt in der tennis-spezifischen Beinarbeit?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What defines the strike step (Schlagschritt) in tennis footwork?" } }
  }
},
"legwork_q7_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der erste explosive Schritt aus dem Split-Step" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The first explosive step from the split-step position" } }
  }
},
"legwork_q7_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der erste explosive Schritt initiiert die Bewegung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The first explosive step initiates movement" } }
  }
},
"legwork_q7_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der große Schritt über den Körper zurück ins Zentrum" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The large step used to cross over the body quickly back to the center" } }
  }
},
"legwork_q7_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies beschreibt den Kreuzschritt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This describes the crossover step" } }
  }
},
"legwork_q7_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der letzte große Schritt zum Ball für eine stabile Position" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The last large step taken to the ball to achieve a stable position" } }
  }
},
"legwork_q7_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schlagschritt ist der letzte große Schritt für Stabilität und Schwerpunktkontrolle" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The strike step is the last large step to ensure stability and proper COG position" } }
  }
},

"legwork_q8_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie wird laut den Kraftquellen des Aufschlags die Bodenreaktionskraft maximal genutzt?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "According to the power sources of the serve, how is ground force maximized?" } }
  }
},
"legwork_q8_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Durch mindestens zwei Sekunden Halten der Stellung vor der Bewegung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "By holding the stance for at least two seconds before initiating the motion" } }
  }
},
"legwork_q8_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies würde den Bewegungsimpuls zerstören" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This would lose momentum" } }
  }
},
"legwork_q8_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Durch schnelles Wegziehen des Wurfarms vom Treffpunkt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "By accelerating the tossing hand away from the contact point quickly" } }
  }
},
"legwork_q8_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies maximiert eher die Rotationskraft" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This primarily maximizes rotational power" } }
  }
},
"legwork_q8_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Durch eine explosive Abwärts- und Aufwärtsbewegung im Beinantrieb" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "By using an explosive down and up action on the leg drive" } }
  }
},
"legwork_q8_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine explosive Abwärts-Aufwärts-Bewegung maximiert die Bodenreaktionskraft" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "An explosive down–up leg drive maximizes ground force" } }
  }
},

"legwork_q9_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Bei einem weiten Rückhand-Volley im Zwei-Schritt-Muster: Welche Beinsequenz ist für einen Rechtshänder korrekt?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "For a right-handed player executing the two-step footwork pattern on a wide backhand volley, what is the correct sequence of leg movements?" } }
  }
},
"legwork_q9_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuerst rechtes Bein, dann mit dem linken Bein in den Volley gehen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Right leg first, then step into the volley with the left leg" } }
  }
},
"legwork_q9_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Sequenz gilt für den Vorhand-Volley" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This sequence is for the forehand volley" } }
  }
},
"legwork_q9_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuerst linkes Bein (seitlich/vorne), dann mit dem rechten Bein in den Volley gehen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Left leg first (outwards/forwards), then step into the volley with the right leg" } }
  }
},
"legwork_q9_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Rückhand-Volley des Rechtshänders startet das Zwei-Schritt-Muster mit dem linken Bein" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "For a right-hander, the two-step backhand volley starts with the left leg" } }
  }
},
"legwork_q9_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Schritte sollten immer seitlich als Shuffle-Steps ausgeführt werden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The steps should always be sideways (shuffle steps) to cover the net" } }
  }
