  }
},




"legwork_q17_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche Strategie wird gegen einen Runner/Pusher empfohlen, um nicht in einen Marathon verwickelt zu werden?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "When facing a Runner/Pusher, what strategy is recommended to avoid getting drawn into a marathon match?" } }
  }
},
"legwork_q17_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Hinter der Grundlinie bleiben und lange Winkel spielen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay behind the baseline and rely on deep angles" } }
  }
},
"legwork_q17_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das spielt dem Runner/Pusher in die Karten" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This plays into the pusher’s strengths" } }
  }
},
"legwork_q17_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Konstant in die Mitte spielen, um die Winkel zu reduzieren" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Hit consistently to the middle to reduce angles" } }
  }
},
"legwork_q17_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das ist zwar eine Taktik, aber keine Lösung gegen lange Ballwechsel" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This is a tactic but does not help finish points" } }
  }
},
"legwork_q17_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Gezielt ans Netz gehen und die Punkte früh beenden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Look for chances to get to the net and finish points early" } }
  }
},
"legwork_q17_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Durch Netzangriffe werden endlose Ballwechsel vermieden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Attacking the net helps avoid long rallies and finish points quickly" } }
  }
},

"legwork_q18_text" : {
  "extractionState" : "manual",
  "localizations" : {
