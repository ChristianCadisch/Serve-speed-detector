"legwork_q16_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Explosiver Abdruck vom äußeren Bein, Überkreuzen und anschließender Split-Step" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Explosive push-off from the outer leg, crossing over, followed by a split-step" } }
