    "recording_page1_desc" : {
      "comment" : "Recording setup page 1 description",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehne dein Handy an eine Trinkflasche oder Tasche. Die Kamera muss komplett ruhig bleiben — Aufnahmen aus der Hand funktionieren nicht"
