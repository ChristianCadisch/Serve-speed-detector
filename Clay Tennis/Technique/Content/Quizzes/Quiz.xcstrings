"volley_q21_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Warum sollte ein Topspin-Volley mit mehr Topspin gespielt werden als ein normaler Grundschlag?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Why is hitting a Topspin Volley—as opposed to a standard volley—recommended to be played with more topspin than a normal groundstroke?" } }
  }
},
"volley_q21_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Damit der Ball schneller abtaucht und den Gegner zu tiefen Returns zwingt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "To ensure the ball dips quickly and forces the opponent into a low return" } }
  }
},
"volley_q21_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Topspin-Volley steht vor allem Kontrolle und Platzierung im Vordergrund" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The focus is on control and placement since the player is close to the net" } }
  }
},
"volley_q21_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Um mehr Kontrolle und Platzierung im vorderen Spielfeld zu erhalten" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "To gain better control and placement since the volley is hit directly inside the service boxes" } }
  }
},
"volley_q21_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Im Vorderfeld ist mehr Topspin sinnvoll für bessere Kontrolle" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Because the Topspin Volley is played directly in the court, it is recommended to be played with more topspin for better control than a normal groundstroke" } }
  }
},
"volley_q21_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Weil der Schläger horizontal durch den Ball beschleunigt werden muss" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Because the racket needs to be accelerated horizontally across the ball" } }
  }
},
"volley_q21_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Topspin-Volley erfolgt die Bewegung eher vorwärts und aufwärts" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The racket is accelerated from hip height forward and upward" } }
  }
