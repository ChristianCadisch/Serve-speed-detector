  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Vorspannung beginnt oben und verläuft entlang der kinetischen Kette nach unten" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The sequence starts with the shoulder axis and continues down the kinematic chain to the ankle" } }
