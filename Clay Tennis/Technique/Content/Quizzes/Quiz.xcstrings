  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Breite Fußstellung und gebeugte Knie" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Wide stance and bent knees" } }
  }
},
"legwork_q15_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "So wird der Körperschwerpunkt näher an die Stützfläche gebracht" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This brings the center of gravity closer to the support base" } }
