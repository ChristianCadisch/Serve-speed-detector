},
"volley_q1_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Eastern Rückhandgriff" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Eastern Backhand Grip" } }
  }
},
"volley_q1_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Griff wird für aggressive einhändige Rückhände verwendet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This grip is used for the aggressive one-handed backhand" } }
  }
},
"volley_q1_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Continental-Griff (Hammergriff)" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Continental Grip (Hammergriff)" } }
  }
},
"volley_q1_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Continentalgriff wird für alle Volleys, Slices und den Smash verwendet, da er stabil ist und einen Griffwechsel überflüssig macht" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The Continental grip, also known as the chopper grip or Hammergriff/Semikontinentalgriff, is used for all volleys, slices, and the smash because it provides stability and saves time by eliminating the need to change grips" } }
  }
},

"volley_q2_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie sollte der Schlägerkopf in der Grundstellung am Netz im Verhältnis zum Griff positioniert sein?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "In the ready position at the net, how should the racket head generally be positioned relative to the grip?" } }
  }
},
"volley_q2_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schlägerkopf zeigt nach unten zum Boden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The racket head should be pointing down towards the ground" } }
  }
},
"volley_q2_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Position erschwert die stabile L-Form" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This position makes it difficult to achieve the necessary 'L' shape for stability" } }
  }
},
"volley_q2_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schlägerkopf ist über dem Griff und bildet eine L-Form" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The racket head should be above the grip, creating an L shape" } }
  }
},
"volley_q2_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Position sorgt für Stabilität und Hebelwirkung beim Volley" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The ready position requires the racket head to be above the grip, creating an L shape, to give stability and leverage on your volleys" } }
  }
},
"volley_q2_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schlägerkopf ist hinter dem Körper für den Ausholschwung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The racket head should be behind the body to prepare for the backswing" } }
  }
},
"volley_q2_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schläger sollte vor dem Körper zwischen Hüfte und Brust gehalten werden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The racket should be kept in front of the upper body, between waist and chest height, for an optimal ready position" } }
  }
},

