"legwork_q9_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Bei einem weiten Rückhand-Volley im Zwei-Schritt-Muster: Welche Beinsequenz ist für einen Rechtshänder korrekt?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "For a right-handed player executing the two-step footwork pattern on a wide backhand volley, what is the correct sequence of leg movements?" } }
  }
},
"legwork_q9_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuerst rechtes Bein, dann mit dem linken Bein in den Volley gehen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Right leg first, then step into the volley with the left leg" } }
  }
},
"legwork_q9_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Sequenz gilt für den Vorhand-Volley" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This sequence is for the forehand volley" } }
  }
},
"legwork_q9_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuerst linkes Bein (seitlich/vorne), dann mit dem rechten Bein in den Volley gehen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Left leg first (outwards/forwards), then step into the volley with the right leg" } }
  }
},
"legwork_q9_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Rückhand-Volley des Rechtshänders startet das Zwei-Schritt-Muster mit dem linken Bein" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "For a right-hander, the two-step backhand volley starts with the left leg" } }
  }
},
"legwork_q9_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Schritte sollten immer seitlich als Shuffle-Steps ausgeführt werden" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The steps should always be sideways (shuffle steps) to cover the net" } }
  }
},
"legwork_q9_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Seitliche Shuffle-Steps sind für weite Bälle meist zu langsam" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Sideways shuffle steps are usually too slow for wide balls" } }
  }
},

"legwork_q10_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Für welchen Schlag ist die geschlossene Schlagstellung besonders vorteilhaft und warum?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The closed striking stance is particularly advantageous for which specific groundstroke, and why?" } }
  }
},
"legwork_q10_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Für die Vorhand, weil sie maximale Oberkörperrotation nutzt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The forehand, because it utilizes maximal upper body rotation" } }
  }
},
"legwork_q10_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die geschlossene Stellung wird eher für Präzision und Stabilität genutzt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The closed stance is typically used for stability and precision" } }
  }
},
"legwork_q10_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Für die beidhändige Rückhand, da sie weniger Platz benötigt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The two-handed backhand, because it minimizes space required for the swing" } }
  }
},
"legwork_q10_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die geschlossene Stellung wird häufiger bei der einhändigen Rückhand genutzt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The closed stance is often used for the one-handed backhand" } }
  }
},
"legwork_q10_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Für die einhändige Rückhand, da sie hohe Stabilität bietet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The one-handed backhand, because it provides good stability" } }
  }
},
"legwork_q10_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die geschlossene Stellung gibt der einhändigen Rückhand mehr Stabilität" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The closed stance is especially advantageous for the one-handed backhand due to stability" } }
  }
},

"legwork_q11_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "In welche Richtung verläuft die Impulsübertragung in der Schlagphase eines Grundschlags?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "When resolving the striking phase of a groundstroke, in which direction does the impulse transfer through the kinematic chain occur?" } }
  }
},
"legwork_q11_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Von oben (Schulter/Arm) nach unten zur Hüfte" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "From the top (shoulder/arm) downwards to the hips" } }
  }
},
"legwork_q11_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies beschreibt die Vorbereitungsphase" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This sequence applies to the preparatory phase" } }
  }
},
"legwork_q11_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Vom Rumpf gleichzeitig nach außen in alle Gliedmaßen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "From the trunk outwards to the limbs simultaneously" } }
  }
},
"legwork_q11_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Impulsübertragung erfolgt als Kettenreaktion, nicht simultan" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Impulse transmission follows a chain reaction, not a simultaneous spread" } }
  }
},
"legwork_q11_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Von unten (Beine) nach oben bis zum Schlagarm" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "From the bottom (legs) upwards towards the striking arm" } }
  }
},
"legwork_q11_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Schlagauflösung verläuft von den Beinen über Hüfte und Rumpf bis zum Arm" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The striking phase resolves from the legs upward through the body to the arm" } }
  }
},

"legwork_q12_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche Bewegung ermöglicht das effektive Stoppen einer Rutschbewegung auf Sand?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "On a clay court, what mechanical action must a player execute to stop the sliding phase effectively?" } }
  }
},
"legwork_q12_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das vollständige Durchstrecken des hinteren Beins" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The player must fully straighten the rear leg" } }
  }
},
"legwork_q12_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das hintere Bein rutscht meist mit gebeugtem Knie" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The rear leg usually slides while bent" } }
  }
},
"legwork_q12_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Den Körperschwerpunkt über das Knie bringen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Bring the center of gravity over the knee" } }
  }
},
"legwork_q12_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "So erhöht sich Druck und Widerstand des Fußes im Sand" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This increases pressure and resistance so the shoe and clay interlock" } }
  }
},
"legwork_q12_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beide Füße gleichzeitig anheben" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Immediately lift both feet off the ground" } }
  }
},
"legwork_q12_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das würde die Bewegung abrupt stoppen, aber nicht effizient" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This would stop movement, but not efficiently" } }
  }
},

"legwork_q13_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Vorhand-Volley im Ein-Schritt-Muster: Welches Bein tritt ein und welche Bewegung sorgt für Stabilität?" } },
