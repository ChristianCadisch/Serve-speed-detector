  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Griff wird hauptsächlich für Vorhandschläge genutzt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This grip is primarily used for forehands" } }
