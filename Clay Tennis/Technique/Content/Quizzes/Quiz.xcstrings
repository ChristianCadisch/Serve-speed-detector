  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Geht der Return cross-court vorbei, soll sich der Partner zwei Schritte lösen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "If the return goes past them cross-court, they should release back two steps" } }
