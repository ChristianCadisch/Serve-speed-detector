      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A Hammer grip"
      }
    }
  }
},
"backhand_q6_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Dieser Griff wird für Aufschläge und Volleys genutzt"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This grip is used for serves and volleys"
      }
    }
  }
},

"backhand_q7_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Wohin bewegt sich der Schläger bei einer reinen Oberkörper-Drehung von der 12-Uhr-Position?"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "During the unit turn on the backhand, if the player coils their upper body without moving their arms, where does the racket move from the initial 12 o'clock position?"
      }
    }
  }
},
"backhand_q7_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zur 6-Uhr-Position (zum Boden)"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To a 6 o'clock position (facing the ground)"
      }
    }
  }
},
"backhand_q7_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Das gehört nicht zur Rückhand-Drehung"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This is not part of the backhand coil"
      }
    }
  }
},
"backhand_q7_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zur 3-Uhr-Position (zur rechten Platzseite)"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To a 3 o'clock position (facing the right side of the court)"
      }
    }
  }
},
"backhand_q7_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Das ist typisch für die Vorhand-Drehung"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "This is typical for forehand coils"
      }
    }
  }
},
"backhand_q7_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Zur 9-Uhr-Position (zur linken Platzseite)"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "To a 9 o'clock position (facing the left side of the court)"
      }
    }
  }
},
"backhand_q7_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "Eine reine Oberkörper-Drehung bringt den Schläger auf 9 Uhr"
      }
    },
    "en" : {
      "stringUnit" : {
        "state" : "translated",
        "value" : "A pure upper-body coil rotates it to 9 o'clock"
      }
    }
  }
},

"backhand_q8_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : {
      "stringUnit" : { "state" : "translated", "value" : "Warum wird der Eastern Rückhandgriff mit der unteren Hand bei der beidhändigen Rückhand nicht empfohlen?" }
    },
    "en" : {
      "stringUnit" : { "state" : "translated", "value" : "Why is using an Eastern backhand grip on the bottom hand discouraged for a two-handed backhand?" }
    }
  }
},
"backhand_q8_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er verursacht zu viel Belastung im Handgelenk" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It causes excessive wrist strain" } }
  }
},
"backhand_q8_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Hauptproblem ist die Flugbahn, nicht die Belastung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The main issue is shot flatness, not strain" } }
  }
},
"backhand_q8_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er erschwert das Durchziehen und das flache Treffen des Balls stark" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It makes it very hard to flatten out the backhand and truly hit through the shot" } }
  }
},
"backhand_q8_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Ball lässt sich damit kaum druckvoll durchschlagen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This grip limits your ability to drive the ball" } }
  }
},
"backhand_q8_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er verhindert, dass die obere Hand dominiert" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It prevents the top hand from dominating the stroke" } }
  }
},
"backhand_q8_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Problem liegt im Abflachen, nicht in der Handdominanz" } },
