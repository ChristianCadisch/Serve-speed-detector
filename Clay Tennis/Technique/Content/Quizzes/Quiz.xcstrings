"forehand_q10_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Warum ist der extreme Vorhandgriff (Westerngriff) langfristig limitierend?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Why is the Extreme Forehand Grip (Westerngriff) limiting for long-term performance?" } }
  }
},
"forehand_q10_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er erschwert das Erzeugen von Topspin" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It makes generating topspin difficult" } }
  }
},
"forehand_q10_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er ist eher für starken Topspin geeignet" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It is suitable for balls with a lot of topspin" } }
  }
},
"forehand_q10_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er ist ungeeignet für flache, schnelle Bälle und tiefe Slices" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It is unsuitable for flat, fast balls and deep slices" } }
  }
},
"forehand_q10_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er schränkt die Schlagvariabilität stark ein" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This grip limits shot variability and is unsuitable for flat/fast balls and deep slice balls" } }
  }
},
"forehand_q10_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Er zwingt zu einer geschlossenen Stellung bei jedem Schlag" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "It requires a closed stance for every shot" } }
  }
},
"forehand_q10_a3_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Das eigentliche Problem ist die eingeschränkte Schlagvielfalt" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The source discusses shot type limitation" } }
  }
},


