            "state" : "translated",
            "value" : "At least 4 shots"
          }
        }
      }
    },
    "tactics_q7_a2_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geduldig Punkte aufbauen, bevor man angreift"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should work the point and make at least four shots before trying for a winner"
          }
        }
      }
    },
    "tactics_q7_a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens 8 Schläge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least 8 shots"
          }
        }
      }
    },
    "tactics_q7_a3_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht notwendig laut Taktik-Empfehlung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tactic recommends at least four shots before attempting a winner"
          }
        }
      }
    },
    "tactics_q7_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegen einen Runner/Pusher – wie viele Schläge solltest du spielen, bevor du einen Winner versuchst?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Against a Runner/Pusher, how many shots should you aim to hit before attempting a winner?"
          }
        }
      }
    },
    "tactics_q8_a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob dein Trainer die Taktik gut findet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your coach approves the tactic"
          }
        }
      }
    },
    "tactics_q8_a1_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der entscheidende Test ist der Matchdruck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coaches know what skills are usable, but the test involves match pressure"
          }
        }
      }
    },
    "tactics_q8_a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob du sie im Training 10-mal hintereinander geschafft hast"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you successfully executed it in practice 10 times in a row"
          }
        }
      }
    },
    "tactics_q8_a2_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training ist nicht gleich Matchsituation"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Success in practice is not the specific usable test defined"
          }
        }
      }
    },
    "tactics_q8_a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob du sie bei 4:4 im dritten Satz spielen würdest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you would try it at 4-all in the third set"
          }
        }
      }
    },
    "tactics_q8_a3_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ja, ist die Taktik wirklich spielbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If yes, the tactic is usable"
          }
        }
      }
    },
    "tactics_q8_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Frage solltest du dir stellen, um zu prüfen, ob eine Taktik wirklich 'spielbar' ist?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What question should you ask yourself to determine if a tactic is truly usable in a competitive match?"
          }
        }
      }
    },
    "tactics_q9_a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schlagen lieber vorbei als zu lobben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They prefer to pass you rather than lob you"
          }
        }
      }
    },
    "tactics_q9_a1_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enges Einrücken zwingt sie zum riskanten Passierschlag"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They prefer to pass rather than lob, so closing tight pressures them"
          }
        }
      }
    },
    "tactics_q9_a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie machen mehr Lob-Fehler"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They often miss the lob if you move closer"
          }
        }
      }
    },
    "tactics_q9_a2_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hauptgrund ist ihre Passier-Vorliebe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reason is their preference for aggressive shots"
          }
        }
      }
    },
    "tactics_q9_a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verkleinerst ihre Zielfläche"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing in tight minimizes their target area"
          }
        }
      }
    },
    "tactics_q9_a3_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein Nebeneffekt, nicht der taktische Hauptgrund"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main reason is their tactical preference for passing"
          }
        }
      }
    },
    "tactics_q9_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum solltest du gegen einen Counter-Puncher am Netz eng einrücken?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When at the net against a Counter-Puncher, why should you close in tight?"
          }
        }
      }
    },
    "tactics_q10_a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bietet die größte Fehlertoleranz und verursacht Verwirrung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It offers the most margin for error and often causes confusion"
          }
        }
      }
    },
    "tactics_q10_a2_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Spieler denken, der andere spielt den Ball"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It offers margin for error and causes confusion between opponents"
          }
        }
      }
    },
    "tactics_q10_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn beide Gegner am Netz stehen, warum ist ein Schlag durch die Mitte so effektiv?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When both opponents are at the net, what is the strategic benefit of passing the ball down the center?"
          }
        }
      }
    },
    "tactics_q11_a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondball"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonball (high loopy groundstroke)"
          }
        }
      }
    },
    "tactics_q11_a3_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt dem Gegner Tempo und Rhythmus"
