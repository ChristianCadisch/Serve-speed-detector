"legwork_q14_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Welche Anweisung gilt für den Doppelpartner des Aufschlägers, wenn der Return cross-court an ihm vorbeigeht?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "What specific footwork instruction is provided for the server's partner in doubles if the return goes past them cross-court?" } }
  }
},
"legwork_q14_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Sofort ans Netz laufen, um die Mitte zu decken" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Immediately run to the net to cover the middle" } }
  }
},
"legwork_q14_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies würde die defensive Position aufgeben" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "This would abandon the defensive position" } }
  }
},
"legwork_q14_a2" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Schnell den Griff wechseln für einen möglichen Passierschlag" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "Quickly change grip for a possible passing shot" } }
  }
},
"legwork_q14_a2_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Anweisung betrifft die Positionierung, nicht den Griff" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "The instruction refers to positioning, not grip" } }
  }
},
"legwork_q14_a3" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Zwei Schritte rückwärts „release back“ machen" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "They must 'release back' two steps" } }
