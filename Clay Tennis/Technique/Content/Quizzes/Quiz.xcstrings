"legwork_q8_text" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie wird laut den Kraftquellen des Aufschlags die Bodenreaktionskraft maximal genutzt?" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "According to the power sources of the serve, how is ground force maximized?" } }
  }
},
"legwork_q8_a1" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Durch mindestens zwei Sekunden Halten der Stellung vor der Bewegung" } },
    "en" : { "stringUnit" : { "state" : "translated", "value" : "By holding the stance for at least two seconds before initiating the motion" } }
  }
},
"legwork_q8_a1_expl" : {
  "extractionState" : "manual",
  "localizations" : {
    "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies würde den Bewegungsimpuls zerstören" } },
