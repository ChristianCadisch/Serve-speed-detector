    "tactics_q13_a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spielst genau sein stärkstes Spiel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You play into the one thing they do better than you"
          }
