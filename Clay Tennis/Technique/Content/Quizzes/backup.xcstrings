      }
    },
    "tactics_q13_a2_expl" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du neutralisierst damit deine eigenen Stärken"
