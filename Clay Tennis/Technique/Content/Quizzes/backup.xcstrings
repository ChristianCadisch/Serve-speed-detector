    "tactics_q12_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In welcher Doppelformation fühlt sich ein Rush & Crush Team am wohlsten?"
